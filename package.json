{
  "name": "browser-sanity",
  "version": "0.8.1",
  "description": "Browser Sanity: sort Chrome tabs into need-based groups with your own AI. A fork of Browser Sanity by Lusk Technologies.",
  "license": "MIT",
  "author": "Jeff Greenberg",
  "contributors": [
    "Lusk Technologies (original Browser Sanity, https://github.com/Greenysmac/browser-sanity)"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "e2e": "xvfb-run -a playwright test",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "package": "node scripts/package.mjs",
    "package:selfhost": "node scripts/package.mjs selfhost",
    "install-host": "node native-host/installer.js",
    "build:sea": "node scripts/build-sea.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "playwright": "^1.61.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greenysmac/browser-sanity.git"
  },
  "homepage": "https://github.com/Greenysmac/browser-sanity"
}
